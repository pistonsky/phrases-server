{
  "name": "phrases-server",
  "version": "0.1.0",
  "description": "Node server for the Phrases mobile app",
  "main": "dist/index.js",
  "engines": {
    "node": "16.2.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch index.ts --watch routes.ts --watch config --watch models --ext ts --exec \"tsc && node -r dotenv/config dist/index.js\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pistonsky/phrases-server.git"
  },
  "keywords": [
    "node",
    "express",
    "server",
    "audio",
    "sound",
    "storage"
  ],
  "author": "Aleksandr Tsygankov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pistonsky/phrases-server/issues"
  },
  "homepage": "https://github.com/pistonsky/phrases-server#readme",
  "dependencies": {
    "axios": "^0.21.1",
    "express": "^4.17.1",
    "express-promise-router": "4.0.1",
    "fbgraph": "^1.4.4",
    "path": "^0.12.7",
    "pg": "^8.5.1",
    "qs": "^6.10.1",
    "url": "^0.11.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "dotenv": "^10.0.0",
    "eslint": "^7.24.0",
    "nodemon": "^2.0.7",
    "prettier": "^2.2.1",
    "prettify": "^0.1.7",
    "typescript": "^7.0.2"
  }
}
