{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["index.ts", "routes.ts", "config/**/*.ts", "models/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "client"]
}
